{
  "name": "skua-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bun --hot server.ts",
    "build:graphs": "bun lib/graphs/build-all.ts",
    "sweep:legacy-zellij": "bun scripts/sweep-legacy-zellij.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:hooks": "tsc --noEmit -p ../../tsconfig.hooks.json",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "install:browsers": "bun run scripts/install-browsers.ts",
    "firestore": "bun run scripts/firestore.ts"
  },
  "optionalDependencies": {
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "yaml": "^2.9.0"
  }
}
