{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun"]
  },
  "include": ["server.ts", "skua.config.ts", "lib/**/*.ts", "scripts/**/*.ts"],
  // Vendored third-party sources ship as-is and are not ours to typecheck.
  "exclude": ["lib/vendor/**", "**/*.test.ts"]
}
